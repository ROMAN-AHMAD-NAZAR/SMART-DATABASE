# API Keys - Choose ONE of the following:

# Option 1: Use Groq (Recommended - Free tier available)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Use OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration (default: cars.db)
DATABASE_FILE=cars.db
